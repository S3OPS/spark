# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///./data/stealth_ai.db

# AI/ML Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
USE_LOCAL_LLM=False
LOCAL_LLM_MODEL=llama2

# Social Media APIs
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StealthAI/1.0

# Payment Processing
STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email Services
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Analytics
GOOGLE_ANALYTICS_ID=your-ga-id

# Deployment
LANDING_PAGE_DOMAIN=https://yourdomain.com
GUMROAD_ACCESS_TOKEN=your-gumroad-token

# Automation Settings
SIGNAL_SCAN_INTERVAL_HOURS=6
CONTENT_POSTING_ENABLED=True
MIN_CONVERSION_THRESHOLD=0.05
AUTO_REINVEST_THRESHOLD=310
TARGET_MONTHLY_REVENUE=8700

# Platform Settings
COMPLY_WITH_TOS=True
MAX_POSTS_PER_DAY=10
ENGAGEMENT_DELAY_SECONDS=30
